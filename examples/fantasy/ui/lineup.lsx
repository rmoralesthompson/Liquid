<main class="app">
  <style>
    /* ---------- Gridiron Guild — lineup page (shares the dashboard theme) ---------- */
    :root {
      --bg: #0b0f14; --panel: #151b23; --panel2: #1a212b;
      --line: rgba(255,255,255,.07); --ink: #eaf2ff; --muted: #8ea0b5; --dim: #5f7186;
      --you: #35f58c; --opp: #ffb020; --live: #ff4d6d;
      --radius: 16px; --shadow: 0 18px 50px -22px rgba(0,0,0,.75);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      color: var(--ink); background: var(--bg);
      background-image:
        radial-gradient(1100px 560px at 50% -12%, rgba(53,245,140,.10), transparent 60%),
        repeating-linear-gradient(90deg, transparent 0 78px, rgba(255,255,255,.022) 78px 80px),
        linear-gradient(180deg, #0b0f14, #0e141b);
      min-height: 100vh; -webkit-font-smoothing: antialiased;
    }
    .app { max-width: 52rem; margin: 0 auto; padding: 1.4rem 1.1rem 3rem; }

    /* top nav with a back link */
    .topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.3rem; }
    .topbar__back { display: inline-flex; align-items: center; gap: .45rem; color: var(--muted); text-decoration: none; font-size: .82rem; font-weight: 700; border: 1px solid var(--line); background: var(--panel); border-radius: 999px; padding: .42rem .9rem .42rem .72rem; transition: border-color .15s, color .15s; }
    .topbar__back:hover { color: var(--ink); border-color: rgba(53,245,140,.4); }
    .topbar__back .chev { color: var(--you); font-weight: 900; }
    .topbar__brand { display: inline-flex; align-items: center; gap: .55rem; font-weight: 800; letter-spacing: -.01em; }
    .topbar__logo { width: 30px; height: 30px; border-radius: 9px; display: grid; place-items: center; background: linear-gradient(135deg, var(--you), #0bbf6a); color: #04160c; font-weight: 900; font-size: .9rem; }
    .topbar__brand em { font-style: normal; color: var(--you); }
    .topbar__me { font-size: .78rem; color: var(--muted); }

    /* hero */
    .hero { margin-bottom: 1rem; }
    .hero__kicker { display: block; font-size: .62rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--you); }
    .hero__title { margin: .3rem 0 .35rem; font-size: 1.75rem; font-weight: 800; letter-spacing: -.02em; }
    .hero__sub { font-size: .86rem; color: var(--muted); margin: 0; }
    .hero__sub strong { color: var(--ink); }
    .hero__sub .opp { color: var(--opp); font-weight: 700; }
    .dot { color: var(--dim); margin: 0 .15rem; }

    /* panel */
    .panel { background: linear-gradient(180deg, var(--panel), var(--panel2)); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.15rem; box-shadow: var(--shadow); }
    .panel__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: .9rem; }
    .panel__kicker { display: block; font-size: .62rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; color: var(--you); }
    .panel__title { margin: .2rem 0 0; font-size: 1.05rem; font-weight: 800; }
    .live-pill { display: inline-flex; align-items: center; gap: .35rem; font-size: .58rem; font-weight: 800; letter-spacing: .14em; color: var(--live); background: rgba(255,77,109,.1); border: 1px solid rgba(255,77,109,.3); padding: .22rem .5rem; border-radius: 999px; }
    .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--live); animation: pulse 1.6s infinite; }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(255,77,109,.5); } 70% { box-shadow: 0 0 0 7px rgba(255,77,109,0); } 100% { box-shadow: 0 0 0 0 rgba(255,77,109,0); } }

    /* roster header total */
    .roster__total { text-align: right; }
    .roster__total-value { font-size: 1.55rem; font-weight: 900; color: var(--you); line-height: 1; font-variant-numeric: tabular-nums; }
    .roster__total-label { display: block; font-size: .54rem; font-weight: 800; letter-spacing: .12em; color: var(--dim); margin-top: .15rem; }

    /* roster rows */
    .roster { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .player { display: grid; grid-template-columns: 2.5rem 40px 1fr minmax(5rem, 9rem) auto; align-items: center; gap: .7rem; padding: .55rem .25rem; border-bottom: 1px solid var(--line); }
    .player:last-child { border-bottom: none; }
    .player__pos { font-size: .6rem; font-weight: 900; letter-spacing: .03em; text-align: center; padding: .28rem 0; border-radius: 6px; color: var(--dim); background: rgba(255,255,255,.04); }
    .player__pos--qb { color: #86efac; background: rgba(53,245,140,.12); }
    .player__pos--rb { color: #7dd3fc; background: rgba(56,189,248,.12); }
    .player__pos--wr { color: #fca5a5; background: rgba(248,113,113,.12); }
    .player__pos--te { color: #fcd34d; background: rgba(255,176,32,.14); }
    .player__pos--flx { color: #d8b4fe; background: rgba(168,85,247,.14); }
    .avatar { width: 40px; height: 40px; display: block; }
    .avatar svg { width: 100%; height: 100%; }
    .player__id { min-width: 0; }
    .player__name { font-weight: 700; font-size: .92rem; }
    .player__meta { display: block; font-size: .68rem; color: var(--dim); }
    .player__bar svg { display: block; width: 100%; height: 6px; }
    .player__bar-track { fill: rgba(255,255,255,.06); }
    .player__bar-fill { fill: var(--you); }
    .player__proj { text-align: right; }
    .player__pts { font-weight: 800; font-size: 1.02rem; font-variant-numeric: tabular-nums; }
    .player__unit { display: block; font-size: .52rem; font-weight: 800; letter-spacing: .1em; color: var(--dim); }

    .footer { margin-top: 1.4rem; text-align: center; font-size: .74rem; color: var(--dim); line-height: 1.7; }
    .footer a { color: var(--you); text-decoration: none; font-weight: 700; }
    .footer a:hover { text-decoration: underline; }

    @media (max-width: 560px) { .player { grid-template-columns: 2.3rem 34px 1fr auto; } .player__bar { display: none; } }
    @media (prefers-reduced-motion: reduce) { * { animation: none !important; transition: none !important; } }
  </style>

  <!-- Shared SVG defs: one clip path the team headshots reference. -->
  <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <defs>
      <clipPath id="avatarClip"><circle cx="24" cy="24" r="23"></circle></clipPath>
    </defs>
  </svg>

  <nav class="topbar" aria-label="Primary">
    <a class="topbar__back" href="/"><span class="chev" aria-hidden="true">&larr;</span> Dashboard</a>
    <span class="topbar__brand"><span class="topbar__logo" aria-hidden="true">G</span>Gridiron <em>Guild</em></span>
    <span class="topbar__me">{{ Manager }}</span>
  </nav>

  <header class="hero">
    <span class="hero__kicker">{{ Week }} &middot; Starters</span>
    <h1 class="hero__title">My Lineup</h1>
    <p class="hero__sub"><strong>{{ Manager }}</strong> <span class="dot">&middot;</span> this week vs <span class="opp">{{ Opponent }}</span></p>
  </header>

  <app-roster></app-roster>

  <footer class="footer">
    Projections stream live over SSE &mdash; no client charting or JS framework.
    <br /><a href="/">&larr; Back to the league dashboard</a>
  </footer>
</main>
