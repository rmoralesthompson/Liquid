<section [hydroId] id="roster" class="panel" aria-live="polite" aria-label="Live starting lineup">
  <div class="panel__head">
    <div class="panel__title-wrap">
      <span class="panel__kicker"><span class="live-dot"></span> Live &middot; SSE</span>
      <h2 class="panel__title">This Week's Starters</h2>
    </div>
    <div class="roster__total">
      <span id="lineup-total" class="roster__total-value">{{ Total }}</span>
      <span class="roster__total-label">PROJ TOTAL</span>
    </div>
  </div>

  <ol class="roster" role="list">
    <li class="player" role="listitem" *goFor="let p of Players">
      <span class="player__pos player__pos--{{ $p.PosClass }}">{{ $p.Pos }}</span>
      <span class="avatar avatar--{{ $p.TeamClass }}">
        <svg viewBox="0 0 48 48" aria-hidden="true">
          <g clip-path="url(#avatarClip)">
            <rect width="48" height="48" fill="currentColor"></rect>
            <circle cx="24" cy="19" r="8.5" fill="#ffffff" opacity="0.92"></circle>
            <path d="M8 45c0-8.6 7.2-14 16-14s16 5.4 16 14z" fill="#ffffff" opacity="0.92"></path>
          </g>
          <circle cx="24" cy="24" r="22.5" fill="none" stroke="#35f58c" stroke-width="1.5" opacity="0.85"></circle>
        </svg>
      </span>
      <span class="player__id">
        <span class="player__name">{{ $p.Name }}</span>
        <span class="player__meta">{{ $p.Team }} <span class="dot">&middot;</span> {{ $p.Pos }} <span class="dot">&middot;</span> {{ $p.Number }}</span>
      </span>
      <span class="player__bar">
        <svg viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
          <rect class="player__bar-track" x="0" y="0" width="100" height="6" rx="3"></rect>
          <rect class="player__bar-fill" x="0" y="0" width="{{ $p.Bar }}" height="6" rx="3"></rect>
        </svg>
      </span>
      <span class="player__proj">
        <span class="player__pts">{{ $p.Points }}</span>
        <span class="player__unit">PROJ</span>
      </span>
    </li>
  </ol>
</section>
