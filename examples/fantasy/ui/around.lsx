<section [hydroId] id="around" class="panel" aria-live="polite" aria-label="Around the league">
  <div class="panel__head">
    <div class="panel__title-wrap">
      <span class="panel__kicker">Week 5 &middot; Live scores</span>
      <h2 class="panel__title">Around the League</h2>
    </div>
    <span class="live-pill" aria-hidden="true"><span class="live-dot"></span>LIVE</span>
  </div>

  <div class="mini-list" role="list">
    <div class="mini {{ $g.FeaturedClass }}" role="listitem" *goFor="let g of Games">
      <button class="mini__row" (click)="Feature" data-idx="{{ $g.Idx }}" aria-label="Feature this matchup">
        <span class="mini__side {{ $g.HomeClass }}">
          <span class="mini__team">{{ $g.Home }}</span>
          <span class="mini__pts">{{ $g.HomeScore }}</span>
        </span>
        <span class="mini__vs">vs</span>
        <span class="mini__side mini__side--r {{ $g.AwayClass }}">
          <span class="mini__pts">{{ $g.AwayScore }}</span>
          <span class="mini__team">{{ $g.Away }}</span>
        </span>
      </button>
      <div class="mini__detail">
        <svg class="winbar__svg mini__bar" viewBox="0 0 100 8" preserveAspectRatio="none" role="img" aria-label="Home win probability">
          <rect class="winbar__track" x="0" y="0" width="100" height="8" rx="4"></rect>
          <rect class="winbar__fill" x="0" y="0" width="{{ $g.WinPct }}" height="8" rx="4"></rect>
        </svg>
        <div class="mini__detail-labels">
          <span>{{ $g.Home }} <strong>{{ $g.WinPct }}%</strong></span>
          <span>{{ $g.Away }}</span>
        </div>
      </div>
    </div>
  </div>
</section>
