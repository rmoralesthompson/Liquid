<section [hydroId] id="standings" class="panel" aria-live="polite" aria-label="League standings">
  <div class="panel__head">
    <div class="panel__title-wrap">
      <span class="panel__kicker">The Gridiron Guild</span>
      <h2 class="panel__title">League Standings</h2>
    </div>
    <div class="seg" role="group" aria-label="Standings view">
      <button class="seg__btn {{ FullClass }}" (click)="ShowFull">Full</button>
      <button class="seg__btn {{ PlayoffClass }}" (click)="ShowPlayoff">Top 6</button>
    </div>
  </div>

  <div class="table" role="table" aria-label="League standings table">
    <div class="table__row table__row--head" role="row">
      <span class="col col--rank" role="columnheader">#</span>
      <span class="col col--team" role="columnheader">Team</span>
      <span class="col col--rec" role="columnheader">Rec</span>
      <span class="col col--pf" role="columnheader">PF</span>
    </div>

    <div class="table__row {{ $t.RowClass }}" role="row" *goFor="let t of Teams">
      <span class="col col--rank" role="cell">
        <span class="table__dot table__dot--{{ $t.LiveClass }}" aria-hidden="true"></span>{{ $t.Rank }}
      </span>
      <span class="col col--team" role="cell">
        <span class="table__name">{{ $t.Name }}</span>
        <span class="table__mgr">{{ $t.Manager }}</span>
      </span>
      <span class="col col--rec" role="cell">{{ $t.Record }}</span>
      <span class="col col--pf" role="cell">{{ $t.PointsFor }}</span>
    </div>
  </div>
</section>
