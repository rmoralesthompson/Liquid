<section [hydroId] id="stat-card" class="card glass">
  <div class="card__head">
    <span class="card__icon card__icon--stat">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 20h4V10H4v10zm6 0h4V4h-4v16zm6 0h4v-7h-4v7z"/></svg>
    </span>
    <h2 class="card__title">{{ Label }}</h2>
  </div>
  <p class="metric-value"><span id="stat-value">{{ Value }}</span></p>
  <p id="pin-state" class="chip" *goIf="Pinned">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16 9V4h1a1 1 0 0 0 0-2H7a1 1 0 0 0 0 2h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z"/></svg>
    Pinned to the top of your reports.</p>
  <div class="card__actions">
    <button id="pin" class="btn btn--tonal" (click)="TogglePin">Toggle pin</button>
  </div>
</section>
