<section [hydroId] id="renamer" class="card glass">
  <div class="card__head">
    <span class="card__icon card__icon--renamer">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 17.25V21h3.75L17.8 9.94l-3.75-3.75L3 17.25zM20.7 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
    </span>
    <h2 class="card__title">Board name</h2>
  </div>
  <p class="metric-value metric-value--text"><span id="board-name">{{ Name }}</span></p>
  <form class="field-row" (submit)="Rename">
    <div class="field">
      <label for="new-name" class="field__label">New name</label>
      <input id="new-name" name="name" class="field__input" autocomplete="off" placeholder="Rename the board…">
    </div>
    <button id="save" class="btn">Save</button>
  </form>
</section>
