{
  "name": "liquid-lsx",
  "displayName": "Liquid .lsx Templates",
  "description": "Language support for Liquid .lsx component templates: syntax highlighting plus live diagnostics, hover, completion, go-to-definition, and occurrence highlights via the liquid language server.",
  "version": "0.2.0",
  "publisher": "rmoralesthompson",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rmoralesthompson/Liquid"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./client/extension.js",
  "activationEvents": [
    "onLanguage:lsx"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "lsx",
        "aliases": [
          "Liquid LSX",
          "lsx"
        ],
        "extensions": [
          ".lsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lsx",
        "scopeName": "text.html.lsx",
        "path": "./syntaxes/lsx.tmLanguage.json"
      },
      {
        "scopeName": "lsx.expression.injection",
        "path": "./syntaxes/lsx-expression.injection.tmLanguage.json",
        "injectTo": [
          "text.html.lsx"
        ]
      },
      {
        "scopeName": "lsx.attributes.injection",
        "path": "./syntaxes/lsx-attributes.injection.tmLanguage.json",
        "injectTo": [
          "text.html.lsx"
        ]
      }
    ],
    "configuration": {
      "title": "Liquid LSX",
      "properties": {
        "liquid.lsx.serverPath": {
          "type": "string",
          "default": "liquid",
          "description": "Path to the liquid CLI used to start the language server (liquid lsp). Leave as \"liquid\" to resolve from PATH."
        }
      }
    }
  }
}
