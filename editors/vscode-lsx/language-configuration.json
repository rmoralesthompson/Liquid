{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "wordPattern": "(\\$[A-Za-z_][A-Za-z0-9_]*)|(\\*[A-Za-z][A-Za-z0-9]*)|([A-Za-z_][A-Za-z0-9_]*(-[A-Za-z0-9_]+)*)",
  "brackets": [
    ["<!--", "-->"],
    ["<", ">"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "'", "close": "'", "notIn": ["string"] },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["'", "'"],
    ["\"", "\""],
    ["<", ">"]
  ]
}
